# Per-server deploy manifest — BIZZYMOD game mode ("Bizzy's Dugout", realism versus).
# Sourced (shell syntax) by .github/workflows/*.yml. Not shipped to the server.

# Lay SirPlease zonemod down as the base overlay first, THEN this server's content.
# zonemod v1.0.0 supplies the confoglcompmod matchmode framework, ~25 configs, and the
# fixes/optional competitive plugin set; the bizzymod overlay adds the bizzymod-family
# config library (24 configs incl. bizzymod/numbersmod/barrymod/...), the bizzymod-custom
# plugins, gamedata, extensions, stripper tree, and vscripts on top.
APPLY_ZONEMOD_OVERLAY=true
ZONEMOD_RELEASE_TAG=v1.0.0

# KEEP the matchmode plugins (confoglcompmod, match_vote, reservedslots) LOADED — this
# is the competitive server; players `!match` to vote a mode. (Opposite of campaign.)
QUARANTINE_MATCHMODE=false

# Nothing to quarantine: this is VERSUS, so the competitive tongue/shove/stagger fixes
# are wanted (unlike coop campaign, which strips the tongue-detour trio).
QUARANTINE_FIXES=""

# SourceMod line to compile bizzymod_stats against (must match what zonemod ships).
SOURCEMOD_VERSION=1.12.x

# NOTE: SourceComms (sbpp_comms) needs a valid, non-zero SourceBans server id, which
# differs per environment. It is supplied as the #{SB_ServerID}# cfg token from the
# GitHub Environment var SB_SERVERID (NOT here — this file holds build flags only).
# Live values from the sourcebans `bans_servers` table:
#   bizzymod-prod (<PROD_HOST>:27015) => SB_SERVERID = 1
#   bizzymod-dev  (<DEV_HOST>:27015) => SB_SERVERID = 3
