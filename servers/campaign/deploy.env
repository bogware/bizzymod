# Per-server deploy manifest — CAMPAIGN game mode.
# Sourced (shell syntax) by .github/workflows/*.yml. Not shipped to the server.

# Lay SirPlease zonemod down as the base overlay before this server's content.
# Campaign runs on the zonemod base, then quarantines matchmode (below).
APPLY_ZONEMOD_OVERLAY=true
ZONEMOD_RELEASE_TAG=v1.0.0

# Move the Versus/matchmode plugins (confoglcompmod, match_vote, reservedslots)
# into plugins/disabled/ so this coop server never locks into match rules.
QUARANTINE_MATCHMODE=true

# Extra fixes/ plugins to quarantine on this server (space-separated .smx):
#   l4d2_hltv_crash_fix    - SourceTV crash fix; sig broken + SourceTV off.
#   l4d2_tank_flying_incap - competitive "tank punch launches the incapped
#                            survivor" mechanic; unwanted on coop Expert.
QUARANTINE_FIXES="l4d2_hltv_crash_fix.smx l4d2_tank_flying_incap.smx"

# SourceMod line to compile against (must match what zonemod ships at runtime).
SOURCEMOD_VERSION=1.12.x
