# Per-server deploy manifest -- VANILLA game mode ("Flat's Hole").
# Sourced (shell syntax) by .github/workflows/*.yml. Not shipped to the server.

# Flat's Hole runs on the SAME zonemod base as campaign (for its stability/bug/
# crash fixes + anticheat) but is VANILLA VERSUS: no gameplay plugins, matchmode
# quarantined, and every gameplay-changing fix disabled (below).
APPLY_ZONEMOD_OVERLAY=true
ZONEMOD_RELEASE_TAG=v1.0.0

# Plain valve versus -- keep the Versus/matchmode plugins out.
QUARANTINE_MATCHMODE=true

# Gameplay-changing fixes to disable for strict vanilla (moved to disabled/).
# KEPT (auto-load): pure crash/exploit/netcode/map/vote fixes. DROPPED here:
# anything that alters SI/survivor behavior, damage, timing, hitboxes, movement,
# shove/stagger, or team shuffling (+ the tongue/tank fixes campaign drops too).
QUARANTINE_FIXES="l4d_tongue_bend_fix.smx l4d_tongue_block_fix.smx l4d_tongue_float_fix.smx l4d2_melee_damage_control.smx fix_fastmelee.smx l4d2_jockey_hitbox_fix.smx l4d2_jockey_jumpcap_patch.smx l4d2_no_post_jockey_deadstops.smx l4d2_charge_target_fix.smx l4d2_fix_firsthit.smx l4d2_spit_spread_patch.smx l4d2_shove_fix.smx l4d_fix_common_shove.smx l4d_fix_shove_duration.smx l4d_fix_stagger_dir.smx l4d_fix_punch_block.smx l4d_static_punch_getup.smx l4d2_boomer_shenanigans.smx l4d2_ai_damagefix.smx l4d2_pistol_delay.smx l4d2_ladderblock.smx l4d2_explosiondmg_prev.smx l4d2_fix_team_shuffle.smx bequiet.smx l4d2_hltv_crash_fix.smx l4d2_tank_flying_incap.smx"

# SourceMod line to compile against (must match the zonemod runtime).
SOURCEMOD_VERSION=1.12.x

# LAUNCH: this is a dedicated VERSUS server, so it MUST boot with +mp_gamemode versus
# (GAMEMODE=versus for .deploy/srcds-launch.sh, or `+mp_gamemode versus` before `+map`
# in the SysV init script). Setting mp_gamemode only in cfg/autoexec.cfg is NOT enough —
# the boot map comes up coop (4 slots) until the first map change. Verified live 2026-09-08.
