# Per-server deploy manifest — MOONLAND ("Bizzy's Moonland").
# Sourced (shell syntax) by .deploy/moonland/build.sh. Not shipped to the server.
#
# Moonland is an UPSTREAM-OVERLAY server: its gameplay content comes from Moon's
# public BizzyMoon repo, pinned below. This directory holds only the local
# overrides laid on top of it. Deploys are manual — see servers/moonland/README.md.
# It is intentionally NOT wired into .github/workflows/deploy.yml.

# Upstream content (bump UPSTREAM_REF deliberately, then rebuild).
UPSTREAM_REPO=https://github.com/MoonL4D2/BizzyMoon.git
UPSTREAM_REF=48282b4c3da8f902c85ede9e17751375c9138139

# Base layer (same zonemod release the other servers run).
APPLY_ZONEMOD_OVERLAY=true
ZONEMOD_RELEASE_TAG=v1.0.0
SOURCEMOD_VERSION=1.12.x

# Service shape.
SRCDS_USER=moonland
GAME_PORT=27017
TICKRATE=60
START_MAP=c6m1_riverbank
# BizzyMoon's server1.cfg only sets `servercfgfile exec.cfg`, so booting with
# server1.cfg skips every config (hostname included) until the second map.
# Boot straight into exec.cfg instead (exec.cfg -> con.cfg + 60.cfg).
SERVERCFGFILE=exec.cfg
CRON_START="14 7 * * *"

# Identity: upstream cfgs hardcode HOSTNAME_FROM; it is rewritten to SERVER_NAME.
SERVER_NAME_DEFAULT="Bizzy's Moonland"
HOSTNAME_FROM="Bizzy's Moonmod"

# Fleet-wide restart-empty grace (seconds). Method stays 2 (`crash`): `_restart`
# does not respawn srcds on these hosts.
RESTART_EMPTY_DELAY=30.0

# Upstream plugins to keep out of the load path (moved to plugins/disabled/).
# l4d_stats is the legacy stats plugin; Moonland reports to bizzymod_stats instead.
DISABLE_PLUGINS="bizzymod/l4d_stats.smx"

# Admins guaranteed to exist in admins_simple.ini even if upstream drops them.
# Format: SteamID|immunity|flags|label (appended only when the account is absent).
ENSURE_ADMINS="STEAM_0:1:121253576|3|z|Moon"
