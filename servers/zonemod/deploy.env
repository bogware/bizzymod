# Per-server deploy manifest -- ZONEMOD game mode ("Bizzy's ZoneMod").
# Sourced (shell syntax) by .github/workflows/*.yml. Not shipped to the server.
#
# Bizzy's ZoneMod = STOCK SirPlease zonemod at its LATEST (master) + a thin
# Bizzymod essentials layer (bizzymod_stats, lilac, SourceBans++, our admins).
# It keeps zonemod exactly as shipped -- full confoglcompmod matchmode, players
# !match to vote zonemod's own config library -- and only adds our stats, bans,
# and anticheat on top.

APPLY_ZONEMOD_OVERLAY=true

# KEY DIFFERENCE from the other servers: they pin the v1.0.0 RELEASE; this one
# tracks the LATEST zonemod from SirPlease *master* (the release is ~6 months
# stale). Pinned to a specific master commit for reproducibility -- bump
# ZONEMOD_REF and re-deploy to pull newer zonemod. ZONEMOD_RELEASE_TAG is left
# empty so the deploy lays the master ref below instead of a release tarball.
ZONEMOD_REF=0390482d48ee87ba16ecb39490dc6f235dbdc1e0   # SirPlease/L4D2-Competitive-Rework @ master, 2026-11-05
ZONEMOD_RELEASE_TAG=

# Full stock zonemod: KEEP the matchmode framework (confoglcompmod / match_vote /
# reservedslots) and ALL competitive fixes loaded. (Opposite of vanilla/Flat's
# Hole, which quarantines them for plain-valve versus.)
QUARANTINE_MATCHMODE=false
QUARANTINE_FIXES=""

# SourceMod line to compile bizzymod_stats against -- must match what zonemod
# master ships. Verify at deploy; 1.12.x as of the pinned commit.
SOURCEMOD_VERSION=1.12.x

# NOTE: like the other servers, SourceComms (sbpp_comms) needs a valid, non-zero
# SourceBans server id, supplied as the #{SB_ServerID}# cfg token per environment
# (from the bans_servers table). bizzymod_stats self-assigns its OWN stats
# server_id from a random per-install data/bizzymod_stats.server_key on first boot
# -- never copy another install's keyfile.
