# Windows thumbnail cache files
Thumbs.db
ehthumbs.db
ehthumbs_vista.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msm
*.msp

# Windows shortcuts
*.lnk

# =========================
# Operating System Files
# =========================
/.vs

# =========================
# Deploy workflow scratch
# =========================
# Cloned by .github/workflows/deploy.yml — do not commit.
/zonemod/
/_zonemod_overlay/
/tmp_spcomp_*/

legacy/
# Untracked reference snapshot of the known-good legacy overlay (carries its
# own l4dtoolz/metamod). Kept locally as reference; never deployed/committed.
older-legacy/

# =========================
# SourceMod runtime state — NEVER commit (contains player PII)
# =========================
# SQLite DBs written on the live host: sourcebans/sourcecomms ban queues carry
# steam_id + name + IP; JockeyPounce carries steam_id + name. These are runtime
# state, regenerated on the box — they must not live in source control.
*.sq3
*.sqlite
*.sqlite3
servers/*/addons/sourcemod/data/sqlite/
